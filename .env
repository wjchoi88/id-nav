# ── 로컬 개발용 (호스트에서 직접 실행) ──────────────────────
# Docker 컨테이너 배포 시 docker-compose.yml 환경변수가 오버라이드함

# Database (호스트 → 포트 5433으로 idnav-db 컨테이너 접속)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=idnav
DB_USER=idnav
DB_PASSWORD=idnav_dev

# API
PORT=3100
NODE_ENV=development

# QR 스캔 URL
QR_BASE_URL=https://id-nav.databuilder.co.kr
QR_HMAC_KEY=idnav_qr_hmac_key_change_in_production
